# ==============================================================================
# CYBERMORPH COMPARISON SUITE GITIGNORE
# ==============================================================================

# 1. Python virtual environment (never commit - too massive)
venv/

# 2. Python compile cache (generated automatically on execution)
__pycache__/
*.pyc
*.pyo
*.pyd

# 3. Bulky per-step training logs (generated locally, re-creatable)
results/*.csv
results_all_steps/

# 3b. Real players' exported play data (has participant codes): never commit
data/

# 4. Trained models: every run's models stay local; only models/frozen/ is committed
#    (the one chosen model, see RESULTS.md). Notes (*.md) are NOT ignored any more:
#    they were lost in the 2026 PC reset because they were never in git.
models/*.zip

# 5. OS-specific system files
.DS_Store
Thumbs.db
